.DS_Store
public/
.chum-cache/

# .obsidian/ is tracked here, unlike the sibling vaults: it carries the editor
# theme, fonts and snippets, and the plugins holding credentials were left out.
# See AGENTS.md. Workspace state is per-machine, so it stays out.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Smart Connections plugin embeddings cache.
.smart-env/

.quartz/node_modules/
.quartz/.quartz/
.quartz/plugins/

# Quartz's transpile cache. Bare pattern, not `.quartz/.quartz-cache/`: the
# directory is actually created at `.quartz/quartz/.quartz-cache/`, one level
# deeper than the path the sibling vaults ignore, so the anchored form misses
# it and the cache gets committed.
.quartz-cache/

# Editor state. Local settings and appearance, not site content; the same
# reasoning that keeps .obsidian/ out.
.antigravity/
.cursor/
.vscode/
.windsurf/
